{
  "retry_time": 10,
  "icon_time": 5,
  "history_path": null,
  "short_cut": "CommandOrControl+Shift+Space",
  "backend_url": "http://www.licpathway.net/transmagent_web",
  "info_template": "group_id: {group_id}, context_id: {context_id}, Call: {model}, Version: {version}, Output:\n\n```json\n{output_format}\n```\n\n",
  "embedding": {
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key": "...",
    "model": "embedding-3",
    "dimension": 1024,
    "enabled": false
  },
  "heartbeat": {
    "enabled": false,
    "interval": 300
  },
  "webserver": {
    "port": 3005
  },
  "func_status": {
    "clip": false,
    "text": false,
    "del": false,
    "react": true,
    "silent": false
  },
  "default": {
    "model": "deepseek[openai]",
    "version": "deepseek-chat",
    "plugin": "baidu_translate",
    "tool_format": "toolcalls",
    "compress_context": false
  },
  "models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "api_type": "ollama",
      "versions": [
        "gpt-oss:20b",
        "qwen3-coder:30b",
        {
          "version": "gemma3:12b",
          "vision": [
            "image"
          ]
        }
      ]
    },
    "deepseek[openai]": {
      "api_url": "https://api.deepseek.com/",
      "api_key": "",
      "api_type": "openai",
      "versions": [
        {
          "version": "deepseek-v4-pro"
        }
      ]
    },
    "deepseek[anthropic]": {
      "api_url": "https://api.deepseek.com/anthropic",
      "api_key": "",
      "api_type": "anthropic",
      "versions": [
        {
          "version": "deepseek-v4-pro"
        }
      ]
    }
  },
  "plugins": {
    "baidu_translate": {
      "show": true
    },
    "image_vision": {
      "params": {
        "api_url": "https://api.gptgod.online/v1/chat/completions",
        "api_key": "...",
        "model": "gpt-4.1-mini"
      },
      "enabled": false
    },
    "browser_client": {
      "enabled": true
    },
    "web_crawler_toolkit": {
      "params": {
        "topk": 15
      },
      "enabled": true
    },
    "python_execute": {
      "params": {
        "python_bin": "python",
        "timeout": 3600,
        "delay_time": 5,
        "show": true,
        "threshold": 40000
      },
      "enabled": false,
      "require_confirmation": true,
      "confirmation_message": "⚠️ 警告：即将执行Python代码。这可能会执行任意代码，存在安全风险。是否继续？"
    },
    "find_files": {
      "enabled": true
    },
    "grep_files": {
      "enabled": true
    },
    "list_dir": {
      "params": {
        "threshold": 50
      },
      "enabled": true
    },
    "write_to_file": {
      "enabled": true,
      "require_confirmation": true,
      "confirmation_message": "⚠️ 警告：即将写入文件。这可能会覆盖现有文件或创建新文件。是否继续？",
      "require_audit": true
    },
    "replace_in_file": {
      "enabled": true,
      "require_confirmation": true,
      "confirmation_message": "⚠️ 警告：即将修改文件内容。这可能会破坏现有文件。是否继续？",
      "require_audit": true
    },
    "error_solution_search": {
      "enabled": false
    },
    "read_tools_prompt": {
      "enabled": false
    },
    "read_skill_instructions": {
      "enabled": true
    },
    "update_tool": {
      "enabled": false
    },
    "cli_execute": {
      "params": {
        "bashrc": "/root/.bashrc",
        "show": true,
        "delay_time": 5,
        "timeout": 3600,
        "monitor_interval": 10,
        "max_lines": 40,
        "max_chars_per_line": 200
      },
      "enabled": true,
      "require_confirmation": true,
      "confirmation_message": "⚠️ 警告：即将执行命令行命令。这可能会修改系统文件或执行危险操作。是否继续？",
      "require_audit": true
    },
    "display_file": {
      "params": {
        "local_path": null
      },
      "enabled": true
    },
    "literature_search": {
      "params": {
        "maxResults": 20,
        "source": "all"
      },
      "enabled": false,
      "show": true,
      "require_confirmation": false,
      "confirmation_message": "即将搜索学术文献，是否继续？"
    }
  },
  "mcp_server": {
    "biotools": {
      "url": "http://0.0.0.0:3001/biotools",
      "disabled": false,
      "use_http": true
    }
  },
  "tool_call": {
    "memory_length": 100,
    "long_memory_length": 200,
    "max_tokens": 100000,
    "mcp_timeout": 60,
    "extra_prompt": null,
    "cli_prompt": null,
    "llm_judge": true,
    "subagent_llm_init": false,
    "max_response_repetitions": 5,
    "repetitions_delay_empty": 2,
    "tmpdir": "/tmp",
    "language": "english",
    "system_platform": "debian12",
    "system_arch": "x86_64",
    "ssh_config": {
      "host": "127.0.0.1",
      "port": 3002,
      "username": "root",
      "password": "password",
      "enabled": true
    },
    "llm_params": {
      "stream": true
    }
  },
  "code": {
    "completion": {
      "trigger_time": 1000,
      "timeout": 10000,
      "prompt": "You are a code/text completion engine. If the cursor <CURSOR> is in the middle of a word, only complete the suffix. If the cursor is at the end of a line, complete the logical continuation. Output code directly, no Markdown. If no completion is needed, return an empty string. You are a code completion tool.\nRules:\n1. Your output will be concatenated directly after the cursor <CURSOR>.\n2. Do not repeat any content that appears before the cursor.\n3. Output only the completion; do not explain and do not include any Markdown markers (e.g. ```).\n4. If the cursor is at the end of a line, usually only complete the logic following the newline.\n5. If no completion is needed, return an empty string.",
      "params": {
        "max_tokens": 200,
        "temperature": 0.2
      }
    },
    "refactor": {
      "trigger_time": 3000,
      "timeout": 20000,
      "prompt": "You are a strict code linter. Identify logical errors. Return JSON in the format: {\"errors\": [{\"text\": \"erroneous_code\", \"fix\": \"fixed_code\"}]}. If there are no errors, return {\"errors\": []}. Do not add any extra explanations.",
      "params": {
        "max_tokens": 500,
        "response_format": {
          "type": "json_object"
        }
      }
    },
    "modify": {
      "prompt": "You are an intelligent code assistant. Modify the provided code snippet according to the user's instructions. Return only the modified code, do not include any Markdown markers (e.g. ```), and do not include any explanatory text. If no changes are needed, return the original code unchanged.",
      "params": {
        "temperature": 0.2
      }
    }
  },
  "chain_call": [
    {
      "end": true
    }
  ],
  "extra": [
    {
      "type": "system-prompt"
    }
  ]
}