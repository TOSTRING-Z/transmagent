{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2022",                       /* 现代 Node/Electron 环境 */
    "module": "CommonJS",                     /* 输出为 CJS 以兼容现有的 require 体系 */
    "outDir": "./dist",                       /* 编译输出目录 */
    "rootDir": "./src",                       /* 源码目录 */
    "declaration": true,                      /* 生成 .d.ts 类型文件提供给其他模块使用 */
    
    /* Module Resolution */
    "moduleResolution": "node",
    "esModuleInterop": true,                  /* 允许 default imports 来引入 CommonJS 模块 (如 import fs from 'fs') */
    "resolveJsonModule": true,

    /* Strict Type-Checking Options */
    "strict": true,                           /* 开启所有严格类型检查 */
    "noImplicitAny": false,                   /* 允许逐步重构迁移，暂时允许部分隐式 any */
    "strictNullChecks": true,
    
    /* Advanced */
    "skipLibCheck": true,                     /* 跳过 node_modules 中的类型检查，加速编译 */
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}